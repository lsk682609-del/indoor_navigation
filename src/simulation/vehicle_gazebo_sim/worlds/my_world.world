<?xml version='1.0'?>
<sdf version='1.7'>
  <world name='default'>
    <!-- 太阳光：没有它 Gazebo 里是黑的 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面：100m x 100m 的无限平面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
        <model name="wall_south">
      <static>true</static>
      <pose>10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>